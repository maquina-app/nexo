module Nexo
  class Agent
    def self.model: (?untyped value) -> untyped
    def self.assume_model_exists: (?untyped value) -> untyped
    def self.provider: (?untyped value) -> untyped
    def self.sandbox: (?untyped value, **untyped opts) -> untyped
    def self.permissions: (?untyped value) -> untyped
    def self.instructions: (?String value) -> String?
    def self.search_backend: (?untyped obj) -> untyped
    def self.file_tools: (?Symbol value) -> Symbol
    def self.llm: () ?{ () [self: singleton(RubyLLM::Agent)] -> void } -> untyped
    def self.context_budget: (?Hash[untyped, untyped]? budget, **untyped shares) -> Hash[untyped, untyped]?
    def self.tools: (*untyped list, ?capability: Symbol?) -> Array[Hash[Symbol, untyped]]

    attr_reader cwd: String
    attr_reader model: untyped
    attr_reader provider: untyped
    attr_reader assume_model_exists: bool
    attr_reader sandbox: Sandbox
    attr_reader permissions: Permissions
    attr_reader instructions: String?

    def initialize: (?cwd: String, ?model: untyped, ?sandbox: untyped, ?permissions: untyped,
                     ?decision: Hash[Symbol, bool]?, ?decisions: Hash[String, bool]?, ?mcp_owner: untyped, ?loop: untyped) -> void
    def mcp_server: (untyped name) -> untyped
    def chat: (?base: untyped) -> RubyLLM::Chat
    def prompt: (String text) ?{ (untyped) -> void } -> untyped
  end
end
