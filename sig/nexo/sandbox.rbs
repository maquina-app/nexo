module Nexo
  class Sandbox
    def read: (String path) -> String
    def write: (String path, String content) -> void
    def shell: (String command, ?timeout: Integer) -> Hash[Symbol, untyped]
    def glob: (String pattern) -> Array[String]
    def close: () -> void
    def instructions: () -> String?
    def supports?: (Symbol capability) -> bool
    def mtime: (String path) -> Time?
  end
end
