module Nexo
  module Sandboxes
    class Local < Sandbox
      attr_reader cwd: String

      attr_reader isolation: untyped

      def self.ruby_paths: () -> Array[String]
      def initialize: (?cwd: String, ?env: Hash[untyped, String], ?isolation: untyped, ?readable: (Array[String | Symbol] | Symbol | String)) -> void
      def confined?: () -> bool
      def hardening_gaps: () -> Array[String]
      def shell: (String command, ?timeout: Numeric) -> Hash[Symbol, untyped]
      def instructions: () -> String
      def supports?: (Symbol cap) -> bool
    end
  end
end
