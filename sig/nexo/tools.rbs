module Nexo
  module Tools
    class Shell < RubyLLM::Tool
      def initialize: (sandbox: Sandbox, permissions: Permissions) -> void
      def execute: (command: String) -> Hash[Symbol, untyped]
    end

    class WebSearch < RubyLLM::Tool
      def initialize: (sandbox: Sandbox, permissions: Permissions, backend: untyped) -> void
      def execute: (query: String) -> Hash[Symbol, untyped]
    end
  end
end
